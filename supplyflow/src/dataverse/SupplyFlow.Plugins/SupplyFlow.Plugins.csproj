<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Multi-target:
      net462  -> the assembly that is actually registered in Dataverse (sandbox runs .NET Framework 4.6.2).
      net8.0  -> same source compiled against Microsoft.PowerPlatform.Dataverse.Client so the
                 unit tests (FakeXrmEasy v3) run cross-platform in CI without Windows/Mono.
  -->
  <PropertyGroup>
    <TargetFrameworks>net462;net8.0</TargetFrameworks>
    <RootNamespace>SupplyFlow.Plugins</RootNamespace>
    <AssemblyName>SupplyFlow.Plugins</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>SupplyFlow.Plugins.snk</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Keep the plugin assembly version stable: changing major/minor creates a new plugin assembly in Dataverse -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.27" />
  </ItemGroup>

</Project>
