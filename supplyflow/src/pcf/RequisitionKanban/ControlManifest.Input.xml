<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <!--
    Kanban board for purchase requisitions. Columns come from the choice metadata of the stage column;
    dragging a card updates the stage through the Web API, so every server rule (state machine,
    segregation of duties, validations) still applies and its message is shown to the user.
  -->
  <control namespace="SupplyFlow" constructor="RequisitionKanban" version="1.0.0"
           display-name-key="Kanban de Requisições (SupplyFlow)"
           description-key="Quadro Kanban por etapa com arrastar-e-soltar e totais por coluna."
           control-type="virtual">
    <external-service-usage enabled="false"></external-service-usage>
    <data-set name="records" display-name-key="Registros" cds-data-set-options="displayCommandBar:true;displayViewSelector:true;displayQuickFind:true">
    </data-set>
    <property name="stageColumn" display-name-key="Coluna de etapa" description-key="Coluna de escolha usada para as raias."
              of-type="SingleLine.Text" usage="input" required="true" default-value="fno_stage" />
    <property name="amountColumn" display-name-key="Coluna de valor" description-key="Coluna de moeda somada em cada raia."
              of-type="SingleLine.Text" usage="input" required="false" default-value="fno_totalamount" />
    <property name="hiddenStages" display-name-key="Etapas ocultas" description-key="Valores separados por vírgula que não viram raias (ex.: canceladas)."
              of-type="SingleLine.Text" usage="input" required="false" default-value="100000006" />
    <resources>
      <code path="index.ts" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
      <uses-feature name="Utility" required="true" />
    </feature-usage>
  </control>
</manifest>
