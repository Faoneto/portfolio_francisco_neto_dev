<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU1701: SDK packages restored for net462 in mixed solutions; NU1903: transitive advisories tracked by Dependabot -->
    <WarningsNotAsErrors>NU1701;NU1902;NU1903;CS1591</WarningsNotAsErrors>
    <Authors>Francisco Alves Oliveira Neto</Authors>
    <Company>SupplyFlow</Company>
    <Product>SupplyFlow – Procure-to-Pay on Dataverse</Product>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
